   "voice": "Benji",
   "voice_id": "e6f9b893-51b1-51d3-afe9-9e0482cb7ac1",
   "text": "סוף סוף... הוא פה.",
   "tts_text": "סוֹף סוֹף... הוּא פֹּה.",
